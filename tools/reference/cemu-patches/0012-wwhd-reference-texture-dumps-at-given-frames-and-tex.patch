 	LattePerformanceMonitor_frameEnd();
 	FrameBenchmarkHelper::FrameEnd();
 	LatteGPUState.frameCounter++;
+#ifdef ENABLE_VULKAN
+	// wwhd-reference: CEMU_TEX_DUMP_FRAME=N[,M...] dumps the GPU-side textures at those swaps (CEMU_TEX_DUMP_DIR;
+	// CEMU_TEX_DUMP_ADDR=hex limits it to textures at that address)
+	{
+		static const std::set<uint32> dumpFrames = [] {
+			std::set<uint32> f;
+			if (const char* e = getenv("CEMU_TEX_DUMP_FRAME"))
+				for (const char* p = e; *p;)
+				{
+					char* end;
+					uint32 v = (uint32)strtoul(p, &end, 10);
+					if (end == p)
+						break;
+					f.insert(v);
+					p = *end == ',' ? end + 1 : end;
+				}
+			return f;
+		}();
+		if (dumpFrames.count(LatteGPUState.frameCounter) && g_renderer->GetType() == RendererAPI::Vulkan)
+		{
+			const char* d = getenv("CEMU_TEX_DUMP_DIR");
+			VulkanRenderer::GetInstance()->DumpTexturesForDebug(d && *d ? d : ".", LatteGPUState.frameCounter);
+		}
+	}
+#endif
 	g_renderer->SwapBuffers(true, true);
 
 	catchOpenGLError();
