<?xml version="1.0" encoding="UTF-8"?>
<!-- Emulated Wii U GamePad driven by the keyboard, for scripted reference runs (xdotool).
     mapping = Cemu VPAD button id, button = X keysym (what wx's GetRawKeyCode returns on GTK). -->
<emulated_controller>
    <type>Wii U GamePad</type>
    <controller>
        <api>Keyboard</api>
        <uuid>keyboard</uuid>
        <display_name>Keyboard</display_name>
        <mappings>
            <entry><mapping>1</mapping><button>120</button></entry>    <!-- A      x -->
            <entry><mapping>2</mapping><button>122</button></entry>    <!-- B      z -->
            <entry><mapping>3</mapping><button>115</button></entry>    <!-- X      s -->
            <entry><mapping>4</mapping><button>97</button></entry>     <!-- Y      a -->
            <entry><mapping>5</mapping><button>113</button></entry>    <!-- L      q -->
            <entry><mapping>6</mapping><button>119</button></entry>    <!-- R      w -->
            <entry><mapping>7</mapping><button>49</button></entry>     <!-- ZL     1 -->
            <entry><mapping>8</mapping><button>50</button></entry>     <!-- ZR     2 -->
            <entry><mapping>9</mapping><button>65293</button></entry>  <!-- Plus   Return -->
            <entry><mapping>10</mapping><button>65288</button></entry> <!-- Minus  BackSpace -->
            <entry><mapping>11</mapping><button>65362</button></entry> <!-- Up     Up -->
            <entry><mapping>12</mapping><button>65364</button></entry> <!-- Down   Down -->
            <entry><mapping>13</mapping><button>65361</button></entry> <!-- Left   Left -->
            <entry><mapping>14</mapping><button>65363</button></entry> <!-- Right  Right -->
            <entry><mapping>17</mapping><button>105</button></entry>   <!-- LStick up     i -->
            <entry><mapping>18</mapping><button>107</button></entry>   <!-- LStick down   k -->
            <entry><mapping>19</mapping><button>106</button></entry>   <!-- LStick left   j -->
            <entry><mapping>20</mapping><button>108</button></entry>   <!-- LStick right  l -->
            <entry><mapping>21</mapping><button>116</button></entry>   <!-- RStick up     t -->
            <entry><mapping>22</mapping><button>103</button></entry>   <!-- RStick down   g -->
            <entry><mapping>23</mapping><button>102</button></entry>   <!-- RStick left   f -->
            <entry><mapping>24</mapping><button>104</button></entry>   <!-- RStick right  h -->
        </mappings>
    </controller>
</emulated_controller>
