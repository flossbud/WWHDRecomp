# Copy to tools/worker/hosts.env (gitignored) and fill in; tools/worker/hosts.sh reads it.
# The worker (the build/test machine, docker): its ssh destination, an ~/.ssh/config alias or user@address
WWHD_WORKER_SSH=worker
# The desktop worker (the owner's PC, rootless podman): user@address, and that account's home
WWHD_DESKTOP_SSH=user@192.0.2.20
WWHD_DESKTOP_HOME=/home/user
# The progress page on the worker (tools/progress/README.md)
WWHD_PROGRESS_URL=http://192.0.2.10:8765
