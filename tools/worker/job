#!/usr/bin/env bash
# job - named, detached jobs in the WWHD worker container (run from the editing machine checkout).
# `WWHD_ON=desktop job start ...` runs it on the owner's desktop (tools/worker/target.sh); wait,
# status, stop and tail find the job on whichever worker has its newest log.
#   job start NAME CMD...      run CMD (from the worker checkout: /wwhd/WWHDRecomp or .worker-dir's)
#                              in its own process group;
#                              log /wwhd/logs/NAME.log, last line EXIT=<code> when done
#   job wait NAME [MINUTES] [STALL_MINUTES]
#                              block until NAME finishes (default 60 min), print the log tail.
#                              Returns early if the log hasn't grown for STALL_MINUTES (default 10)
#                              or the job's process vanished without writing EXIT=.
#                              exit 0 = EXIT=0, 1 = failed, 2 = timeout, 3 = stalled, 4 = died
#   job status NAME            running | done EXIT=n | unknown
#   job stop NAME              kill NAME's whole process group (and nothing else)
#   job tail NAME [N]          last N log lines (default 20)
# Why: ad-hoc pkill/pattern kills once matched the wrong job's wrapper and silently cancelled it.
set -euo pipefail
dir=$(cat "$(cd "$(dirname "$0")/../.." && pwd)/.worker-dir" 2>/dev/null || echo /wwhd/WWHDRecomp)
cmd=${1:?usage: job start|wait|status|stop|tail NAME ...}; name=${2:?job name required}; shift 2
case "$name" in *[!A-Za-z0-9._-]*) echo "job: bad name '$name'" >&2; exit 2 ;; esac
# a parallel session's jobs carry its name (.session, gitignored), so two sessions' logs never meet
sess=$(cat "$(cd "$(dirname "$0")/../.." && pwd)/.session" 2>/dev/null || true)
[ -n "$sess" ] && case "$name" in "$sess"-*) ;; *) name=$sess-$name ;; esac
here=$(cd "$(dirname "$0")" && pwd)
if [ "$cmd" != start ] && [ -z "${WWHD_ON:-}" ]; then
    WWHD_ON=worker
    dt=$(ssh -o BatchMode=yes -o ConnectTimeout=5 owner@DESKTOP_ADDR "stat -c %Y /home/owner/wwhd-desk/logs/$name.log 2>/dev/null" 2>/dev/null || true)
    if [ -n "$dt" ]; then
        mt=$(ssh -o BatchMode=yes worker "stat -c %Y /wwhd/logs/$name.log 2>/dev/null" || true)
        if [ -z "$mt" ] || [ "$dt" -gt "$mt" ]; then WWHD_ON=desktop; fi
    fi
fi
source "$here/target.sh"
clog=/wwhd/logs/$name.log cpid=/wwhd/logs/$name.pid      # inside the container
log=$(hostpath "$clog") pid=$(hostpath "$cpid")             # on the worker's host
# ssh joins its arguments into one string for the *remote* shell, so quote every word for it
dx() { on_host "$(printf '%q ' $W_ENGINE exec "$@")"; }

status() {
    on_host "if grep -q '^EXIT=' $log 2>/dev/null; then echo \"done \$(grep '^EXIT=' $log | tail -1)\";
        elif [ -f $pid ] && $W_ENGINE exec wwhd-worker kill -0 \$(cat $pid) 2>/dev/null; then echo running; else echo unknown; fi"
}

case "$cmd" in
start)
    [ $# -gt 0 ] || { echo "job start NAME CMD..." >&2; exit 2; }
    on_host "$W_ENGINE container inspect -f '{{.State.Running}}' wwhd-worker 2>/dev/null" | grep -q true ||
        { echo "job: the worker on $WWHD_ON isn't running (tools/worker/desktop.sh status); use the other one" >&2; exit 1; }
    [ "$(status)" = running ] && { echo "job $name is already running" >&2; exit 1; }
    inner=$(printf '%q ' "$@")
    dx -d -w "$dir" wwhd-worker setsid bash -c \
        "echo \$\$ > $cpid; { $inner; } > $clog 2>&1; echo EXIT=\$? >> $clog"
    echo "started $name on $WWHD_ON (log $log)" ;;
wait)
    deadline=$(( $(date +%s) + ${1:-60} * 60 )); stall=$(( ${2:-10} * 60 ))
    last_size=-1; last_change=$(date +%s)
    while :; do
        s=$(status)
        [[ $s == done* ]] && break
        if [ "$s" = unknown ]; then
            echo "job $name: process gone without EXIT= (died or was killed)" >&2
            on_host "tail -5 $log" >&2; exit 4
        fi
        size=$(on_host "stat -c %s $log 2>/dev/null || echo 0")
        now=$(date +%s)
        if [ "$size" != "$last_size" ]; then last_size=$size; last_change=$now; fi
        if [ $(( now - last_change )) -ge "$stall" ]; then
            echo "job $name: log unchanged for ${2:-10} min (stalled?)" >&2
            on_host "tail -5 $log" >&2; exit 3
        fi
        [ "$now" -gt "$deadline" ] && { echo "job $name: still running after ${1:-60} min" >&2; exit 2; }
        sleep 15
    done
    on_host "grep -vE '^\[[0-9]+/[0-9]+\] ' $log | tail -15"
    [[ $s == "done EXIT=0" ]] ;;
status) status ;;
stop)
    on_host "[ -f $pid ] && $W_ENGINE exec wwhd-worker kill -- -\$(cat $pid) 2>/dev/null; echo stopped" ;;
tail) on_host "tail -${1:-20} $log" ;;
*) echo "job: unknown command $cmd" >&2; exit 2 ;;
esac
